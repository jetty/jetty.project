<?xml version="1.0"?><!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">

<Configure>
  <Ref refid="deploymentScanner">
    <Call name="configureEnvironment">
      <Arg>test </Arg>
      <Set name="classLoaderFactoryClassName">
        <Property name="jetty.deploy.classLoaderFactoryClass" default="org.eclipse.jetty.deploy.test.TestClassLoaderFactory" />
      </Set>
      <Set name="defaultContextHandlerClassName">
        <Property name="jetty.deploy.defaultContextHandlerClass" default="org.eclipse.jetty.deploy.test.TestContextHandler" />
      </Set>
      <Call name="loadPropertiesFromPathName">
        <Arg>
          <Property name="jetty.deploy.common.properties" />
        </Arg>
      </Call>
    </Call>
  </Ref>
</Configure>
