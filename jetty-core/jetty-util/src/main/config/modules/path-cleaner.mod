# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Cleans up paths during startup (early, late, never)

[tags]
startup

[xml]
etc/path-cleaner.xml

[ini-template]
# tag::documentation[]
## Paths to clean
# jetty.path-cleanup.files=secrets.txt,config/password-for-database.json

## The cleanup mode
## The mode options:
##  - EARLY - this will cleanup the files as early as possible.
##  - LATE  - this will defer cleanup via Java's File.deleteOnExit
##  - NEVER - this will never cleanup the specified files (useful for debug)
# jetty.path-cleanup.mode=EARLY

# end::documentation[]
