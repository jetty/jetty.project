<inherit>

[depends]
ee-apache-jsp

[lib]
lib/ee-glassfish-jstl/@jakarta.servlet.jsp.jstl:jakarta.servlet.jsp.jstl-api@
lib/ee-glassfish-jstl/@org.glassfish.wasp:wasp@
