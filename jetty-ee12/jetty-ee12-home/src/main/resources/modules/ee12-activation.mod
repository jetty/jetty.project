# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Provides the Jakarta Activation API and the Eclipse Angus implementation.

[environment]
ee12

[ini]
ee12.jakarta.activation.api.version?=@version(jakarta.activation:jakarta.activation-api)@
ee12.org.eclipse.angus.activation.version?=@version(org.eclipse.angus:angus-activation)@

[files]
maven://jakarta.activation/jakarta.activation-api/${ee12.jakarta.activation.api.version}/jar|lib/ee12/support/jakarta.activation.jakarta.activation-api-${ee12.jakarta.activation.api.version}.jar
maven://org.eclipse.angus/angus-activation/${ee12.org.eclipse.angus.activation.version}/jar|lib/ee12/support/org.eclipse.angus.angus-activation-${ee12.org.eclipse.angus.activation.version}.jar

[lib]
lib/ee12/support/jakarta.activation.jakarta.activation-api-${ee12.jakarta.activation.api.version}.jar
lib/ee12/support/org.eclipse.angus.angus-activation-${ee12.org.eclipse.angus.activation.version}.jar
