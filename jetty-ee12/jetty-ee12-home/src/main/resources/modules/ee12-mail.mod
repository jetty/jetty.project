# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Provides the Jakarta Mail API and the Eclipse Angus implementation.

[environment]
ee12

[depends]
ee12-activation

[ini]
ee12.jakarta.mail.api.version?=@version(jakarta.mail:jakarta.mail-api)@
ee12.org.eclipse.angus.mail.version?=@version(org.eclipse.angus:angus-mail)@

[files]
maven://jakarta.mail/jakarta.mail-api/${ee12.jakarta.mail.api.version}/jar|lib/ee12/support/jakarta.mail.jakarta.mail-api-${ee12.jakarta.mail.api.version}.jar
maven://org.eclipse.angus/angus-mail/${ee12.org.eclipse.angus.mail.version}/jar|lib/ee12/support/org.eclipse.angus.angus-mail-${ee12.org.eclipse.angus.mail.version}.jar

[lib]
lib/ee12/support/jakarta.mail.jakarta.mail-api-${ee12.jakarta.mail.api.version}.jar
lib/ee12/support/org.eclipse.angus.angus-mail-${ee12.org.eclipse.angus.mail.version}.jar
