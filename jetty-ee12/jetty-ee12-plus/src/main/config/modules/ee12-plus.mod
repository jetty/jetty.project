# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Enables Servlet resource injection.

[environment]
ee12

[depends]
ee/common-plus
server
jndi
plus
ee12-security
ee12-webapp

[ini]
ee12.jakarta.cdi.api.version?=@version(jakarta.cdi:jakarta.cdi-api)@
ee12.jakarta.cdi.lang.model.api.version?=@version(jakarta.cdi:jakarta.cdi-lang-model-api)@
ee12.jakarta.inject.api.version?=@version(jakarta.inject:jakarta.inject-api)@
ee12.jakarta.interceptor.api.version?=@version(jakarta.interceptor:jakarta.interceptor-api)@
ee12.jakarta.transaction.api.version?=@version(jakarta.transaction:jakarta.transaction-api)@

[files]
maven://jakarta.cdi/jakarta.cdi-api/${ee12.jakarta.cdi.api.version}/jar|lib/ee12/support/jakarta.cdi.jakarta.cdi-api-${ee12.jakarta.cdi.api.version}.jar
maven://jakarta.cdi/jakarta.cdi-lang-model-api/${ee12.jakarta.cdi.lang.model.api.version}/jar|lib/ee12/support/jakarta.cdi.jakarta.cdi-lang-model-api-${ee12.jakarta.cdi.lang.model.api.version}.jar
maven://jakarta.inject/jakarta.inject-api/${ee12.jakarta.inject.api.version}/jar|lib/ee12/support/jakarta.inject.jakarta.inject-api-${ee12.jakarta.inject.api.version}.jar
maven://jakarta.interceptor/jakarta.interceptor-api/${ee12.jakarta.interceptor.api.version}/jar|lib/ee12/support/jakarta.interceptor.jakarta.interceptor-api-${ee12.jakarta.interceptor.api.version}.jar
maven://jakarta.transaction/jakarta.transaction-api/${ee12.jakarta.transaction.api.version}/jar|lib/ee12/support/jakarta.transaction.jakarta.transaction-api-${ee12.jakarta.transaction.api.version}.jar
maven://org.eclipse.jetty.ee12/jetty-ee12-plus/${jetty.version}/jar|lib/ee12/jetty-ee12-plus-${jetty.version}.jar

[lib]
lib/ee12/jetty-ee12-plus-${jetty.version}.jar
lib/ee12/support/jakarta.cdi.jakarta.cdi-api-${ee12.jakarta.cdi.api.version}.jar
lib/ee12/support/jakarta.cdi.jakarta.cdi-lang-model-api-${ee12.jakarta.cdi.lang.model.api.version}.jar
lib/ee12/support/jakarta.inject.jakarta.inject-api-${ee12.jakarta.inject.api.version}.jar
lib/ee12/support/jakarta.interceptor.jakarta.interceptor-api-${ee12.jakarta.interceptor.api.version}.jar
lib/ee12/support/jakarta.transaction.jakarta.transaction-api-${ee12.jakarta.transaction.api.version}.jar
