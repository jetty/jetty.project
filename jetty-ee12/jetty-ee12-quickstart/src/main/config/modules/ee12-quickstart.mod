# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Enables the Jetty Quickstart module for rapid deployment of preconfigured web applications.

[environment]
ee12

[depends]
ee/common-quickstart
server
ee12-annotations
ee12-webapp
ee12-plus

[xml]
etc/jetty-ee12-quickstart.xml

[files]
maven://org.eclipse.jetty.ee12/jetty-ee12-quickstart/${jetty.version}/jar|lib/ee12/jetty-ee12-quickstart-${jetty.version}.jar

[lib]
lib/ee12/jetty-ee12-quickstart-${jetty.version}.jar

[ini-template]

# Modes are AUTO, GENERATE, QUICKSTART
# jetty.quickstart.mode=AUTO
# jetty.quickstart.origin=origin
# jetty.quickstart.xml=
