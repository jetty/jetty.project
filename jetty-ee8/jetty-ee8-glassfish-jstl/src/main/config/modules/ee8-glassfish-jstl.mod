# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Enables the glassfish version of JSTL for all webapps.

[environment]
ee8

[ini]
ee8.jakarta.servlet.jsp.jstl.api.version?=@version(jakarta.servlet.jsp.jstl:jakarta.servlet.jsp.jstl-api)@
ee8.jakarta.servlet.jsp.jstl.impl.version?=@version(org.glassfish.web:javax.servlet.jsp.jstl)@

[files]
maven://jakarta.servlet.jsp.jstl/jakarta.servlet.jsp.jstl-api/${ee8.jakarta.servlet.jsp.jstl.api.version}/jar|lib/ee8/support/jakarta.servlet.jsp.jstl.jakarta.servlet.jsp.jstl-api-${ee8.jakarta.servlet.jsp.jstl.api.version}.jar
maven://org.glassfish.web/javax.servlet.jsp.jstl/${ee8.jakarta.servlet.jsp.jstl.impl.version}/jar|lib/ee8/support/org.glassfish.web.javax.servlet.jsp.jstl-${ee8.jakarta.servlet.jsp.jstl.impl.version}.jar

[lib]
lib/ee8/support/jakarta.servlet.jsp.jstl.jakarta.servlet.jsp.jstl-api-${ee8.jakarta.servlet.jsp.jstl.api.version}.jar
lib/ee8/support/org.glassfish.web.javax.servlet.jsp.jstl-${ee8.jakarta.servlet.jsp.jstl.impl.version}.jar
