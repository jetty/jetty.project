[description]
Enables the glassfish version of JSTL for all webapps.

[environment]
ee8

[ini]

[lib]
lib/ee8-glassfish-jstl/@jakarta.servlet.jsp.jstl:jakarta.servlet.jsp.jstl-api@
lib/ee8-glassfish-jstl/@org.glassfish.web:javax.servlet.jsp.jstl@
