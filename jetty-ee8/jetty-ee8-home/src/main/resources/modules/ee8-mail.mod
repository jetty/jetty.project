# DO NOT EDIT THIS FILE - See: https://jetty.org/docs/

[description]
Provides the JavaMail API and implementation (GlassFish javax.mail).

[environment]
ee8

[ini]
ee8.javax.mail.glassfish.version?=@version(org.eclipse.jetty.orbit:javax.mail.glassfish)@

# The orbit javax.mail.glassfish jar has no Automatic-Module-Name, so its JPMS
# module name is derived from the jar file name. The org.eclipse.jetty.ee8.jndi
# module requires it as "javax.mail.glassfish" (MailSessionReference), so the jar
# must keep that file name here rather than the groupId.artifactId form used by the
# other support jars, or ee8.jndi fails to read it under JPMS.
[files]
maven://org.eclipse.jetty.orbit/javax.mail.glassfish/${ee8.javax.mail.glassfish.version}/jar|lib/ee8/support/javax.mail.glassfish-${ee8.javax.mail.glassfish.version}.jar

[lib]
lib/ee8/support/javax.mail.glassfish-${ee8.javax.mail.glassfish.version}.jar
