<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_9_3.dtd">

<Configure id="Server" class="org.eclipse.jetty.server.Server">

    <!-- =========================================================== -->
    <!-- Configure a deployer for WebAppContexts and ContextHandlers -->
    <!-- =========================================================== -->
    <Call name="addBean">
      <Arg>
        <New id="DeploymentManager" class="org.eclipse.jetty.deploy.GoalDeployer">
          <Arg name="contexts">
            <Ref refid="Contexts" />
          </Arg>
        </New>
      </Arg>
    </Call>

</Configure>
