[description]
Google Cloud modules for Jetty

[tags]
gcloud

[depends]
server

[files]
maven://com.google.cloud/google-cloud-logging/3.7.0/google-cloud-logging-3.7.0.jar
maven://com.google.cloud/google-cloud-trace/2.4.0/google-cloud-trace-2.4.0.jar
maven://com.google.cloud/google-cloud-monitoring/3.3.0/google-cloud-monitoring-3.3.0.jar
maven://com.google.cloud/google-cloud-errorreporting/0.132.0-beta/google-cloud-errorreporting-0.132.0-beta.jar
maven://com.google.cloud.google-cloud-core/2.10.0/google-cloud-core-2.10.0.jar

[ini]
jetty.gcloud.enabled=true

