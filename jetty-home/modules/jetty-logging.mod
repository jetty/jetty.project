[description]
Provides logging libraries (e.g., SLF4J, Logback) for Jetty.

[tags]
logging

[depends]

[lib]
# No libs shipped; downloaded on demand

[maven]
org.eclipse.jetty:jetty-logging:${jetty.version}

[download]
baseid=jetty-logging
url=https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-logging/${jetty.version}/jetty-logging-${jetty.version}.jar
