<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Jetty//Jetty Home Module//EN" "http://www.eclipse.org/jetty/dtd/jetty-home-module.dtd">
<module>
  <name>jetty-http</name>
  <description>Jetty HTTP core module. Downloads HTTP implementation.</description>
  <depends>jetty-io</depends>
  <download>
    <groupId>org.eclipse.jetty</groupId>
    <artifactId>jetty-http</artifactId>
    <version>${jetty.version}</version>
  </download>
  <lib>
    <name>jetty-http</name>
  </lib>
</module>