<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" name="Jetty" >

  <properties>
    <property name="logging.dir">${sys:jetty.logging.dir:-logs}</property>
  </properties>

  <Appenders>
    <Console name="console" target="SYSTEM_ERR">
      <PatternLayout>
        <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Pattern>
      </PatternLayout>
    </Console>


    <RollingRandomAccessFile name="file"
      fileName="${logging.dir}/jetty.log"
      filePattern="${logging.dir}/jetty-%d{MM-dd-yyyy}.log.gz"
      ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%m%n</Pattern>
      </PatternLayout>

      <Policies>
        <TimeBasedTriggeringPolicy />
        <SizeBasedTriggeringPolicy size="10 MB"/>
      </Policies>
    </RollingRandomAccessFile>

    <RollingRandomAccessFile name="file_custom"
                             fileName="${logging.dir}/jetty_custom.log"
                             filePattern="${logging.dir}/jetty_custom-%d{MM-dd-yyyy}.log.gz"
                             ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%c - %m%n</Pattern>
      </PatternLayout>

      <Policies>
        <TimeBasedTriggeringPolicy />
        <SizeBasedTriggeringPolicy size="10 MB"/>
      </Policies>
    </RollingRandomAccessFile>

  </Appenders>

  <Loggers>
    <Logger name="org.eclipse.jetty.server.RequestLog" level="info" additivity="false">
      <AppenderRef ref="file" />
    </Logger>
    <Logger name="request_logs" level="info" additivity="false">
      <AppenderRef ref="file_custom" />
    </Logger>
    <Root level="info">
      <AppenderRef ref="console"/>
    </Root>
  </Loggers>

</Configuration>

